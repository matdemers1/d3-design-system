{
  "$description": "Typography tokens. Inter (SIL OFL 1.1) for interface text, JetBrains Mono (SIL OFL 1.1) for metadata. Both self-hosted \u2014 see tokens/fonts/.",
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": [
          "Inter",
          "ui-sans-serif",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "sans-serif"
        ],
        "$description": "interface text"
      },
      "mono": {
        "$type": "fontFamily",
        "$value": [
          "JetBrains Mono",
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "monospace"
        ],
        "$description": "reference IDs, timings, byte counts, hashes, keyboard hints \u2014 never interface text"
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400,
        "$description": "body, table cells, paragraphs"
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500,
        "$description": "anything interactive"
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": 600,
        "$description": "headings, labels, primary button"
      },
      "title": {
        "$type": "fontWeight",
        "$value": 650,
        "$description": "page title only"
      }
    },
    "size": {
      "11": {
        "$type": "dimension",
        "$value": "11px",
        "$description": "uppercase label, table header, keyboard hint",
        "$extensions": {
          "d3.ratio": 0.79
        }
      },
      "12": {
        "$type": "dimension",
        "$value": "12px",
        "$description": "metadata, caption, validation error",
        "$extensions": {
          "d3.ratio": 0.86
        }
      },
      "13": {
        "$type": "dimension",
        "$value": "13px",
        "$description": "dense label, chip, button",
        "$extensions": {
          "d3.ratio": 0.93
        }
      },
      "14": {
        "$type": "dimension",
        "$value": "14px",
        "$description": "body \u2014 base",
        "$extensions": {
          "d3.ratio": 1.0
        }
      },
      "16": {
        "$type": "dimension",
        "$value": "16px",
        "$description": "emphasis, empty-state heading",
        "$extensions": {
          "d3.ratio": 1.14
        }
      },
      "20": {
        "$type": "dimension",
        "$value": "20px",
        "$description": "section title",
        "$extensions": {
          "d3.ratio": 1.43
        }
      },
      "24": {
        "$type": "dimension",
        "$value": "24px",
        "$description": "page title",
        "$extensions": {
          "d3.ratio": 1.71
        }
      }
    },
    "lineHeight": {
      "11": {
        "$type": "number",
        "$value": 1.3
      },
      "12": {
        "$type": "number",
        "$value": 1.5
      },
      "13": {
        "$type": "number",
        "$value": 1.4
      },
      "14": {
        "$type": "number",
        "$value": 1.55
      },
      "16": {
        "$type": "number",
        "$value": 1.5
      },
      "20": {
        "$type": "number",
        "$value": 1.35
      },
      "24": {
        "$type": "number",
        "$value": 1.25
      }
    }
  },
  "measure": {
    "body": {
      "$type": "dimension",
      "$value": "65ch",
      "$description": "75ch hard maximum"
    },
    "cell": {
      "$type": "dimension",
      "$value": "38ch",
      "$description": "then truncate with a tooltip"
    },
    "helper": {
      "$type": "dimension",
      "$value": "50ch",
      "$description": "empty states, helper text"
    }
  }
}
