{
  "name": "@d3cloud/ui",
  "version": "0.1.1",
  "description": "The D3 Cloud component library. Consumed by Bindery, App B, App C and App A.",
  "type": "module",
  "license": "UNLICENSED",
  "private": false,
  "files": [
    "dist",
    "src/tokens",
    "scripts"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css",
    "./theme.css": "./src/tokens/build/theme.css",
    "./tokens/*": "./src/tokens/*",
    "./tokens.css": "./src/tokens/build/tokens.css"
  },
  "bin": {
    "d3-check-usage": "./scripts/check-usage.mjs"
  },
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build && npm run check:dist",
    "dev": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test": "vitest run",
    "test:a11y": "test-storybook",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "test:watch": "vitest",
    "verify": "npm run check:tokens && npm run check:usage && npm run typecheck && npm run test && npm run build",
    "check:dist": "node scripts/check-dist.mjs",
    "check:tokens": "node ../design-system/scripts/check-tokens.mjs",
    "check:usage": "node scripts/check-usage.mjs src"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8.6.0",
    "@storybook/addon-essentials": "^8.6.0",
    "@storybook/react-vite": "^8.6.0",
    "@storybook/test-runner": "^0.21.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.7",
    "axe-core": "^4.13.0",
    "jsdom": "^26.1.0",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^8.6.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.4.0",
    "vitest": "^3.0.0"
  }
}
